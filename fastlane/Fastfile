# frozen_string_literal: true

default_platform(:ios)

def load_api_key_if_present
  app_store_connect_api_key(
    key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
    issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
    key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY_CONTENT'].to_s.gsub('\\n', "\n"),
    is_key_content_base64: false,
    duration: 1200,
    in_house: false
  )
end

def sync_for_platform(platform_name:, readonly:)
  app_identifiers = [ENV['APP_IDENTIFIER'], ENV['WIDGET_IDENTIFIER']]

  api_key = readonly ? nil : load_api_key_if_present

  %w[development appstore].each do |cert_type|
    params = {
      type: cert_type,
      platform: platform_name,
      app_identifier: app_identifiers,
      readonly: readonly
    }
    params[:api_key] = api_key if api_key
    params[:force_for_new_devices] = true if !readonly && cert_type == 'development'

    sync_code_signing(**params)
  end
end

def build_and_upload_for_platform(platform_name:, destination:, app_store_platform:, artifact:)
  provisioning_profile_suffix = platform_name == 'macos' ? ' macos' : ''
  provisioning_profiles = {
    ENV['APP_IDENTIFIER'] => "match AppStore #{ENV['APP_IDENTIFIER']}#{provisioning_profile_suffix}",
    ENV['WIDGET_IDENTIFIER'] => "match AppStore #{ENV['WIDGET_IDENTIFIER']}#{provisioning_profile_suffix}"
  }

  build_app(
    project: File.expand_path('../CSUSTPlanet.xcodeproj', __dir__),
    scheme: 'CSUSTPlanet',
    configuration: 'Release',
    destination: destination,
    export_method: 'app-store',
    export_options: {
      provisioningProfiles: provisioning_profiles
    },
    output_directory: File.expand_path("builds/#{platform_name}", __dir__)
  )

  artifact_path = lane_context[
    artifact == :ipa ? SharedValues::IPA_OUTPUT_PATH : SharedValues::PKG_OUTPUT_PATH
  ]

  upload_to_app_store(
    api_key: load_api_key_if_present,
    app_identifier: ENV['APP_IDENTIFIER'],
    platform: app_store_platform,
    artifact => artifact_path,
    skip_metadata: true,
    skip_screenshots: true,
    submit_for_review: false,
    precheck_include_in_app_purchases: false
  )
end

platform :ios do
  desc '同步 iOS 证书'
  lane :sync_certs do
    sync_for_platform(platform_name: 'ios', readonly: true)
  end

  desc '创建或更新 iOS 证书'
  lane :update_certs do
    sync_for_platform(platform_name: 'ios', readonly: false)
  end

  desc '构建 iOS 正式包并上传到 App Store Connect'
  lane :release do
    build_and_upload_for_platform(
      platform_name: 'ios',
      destination: 'generic/platform=iOS',
      app_store_platform: 'ios',
      artifact: :ipa
    )
  end
end

platform :mac do
  desc '同步 macOS 证书'
  lane :sync_certs do
    sync_for_platform(platform_name: 'macos', readonly: true)
  end

  desc '创建或更新 macOS 证书'
  lane :update_certs do
    sync_for_platform(platform_name: 'macos', readonly: false)
  end

  desc '构建 macOS 正式包并上传到 App Store Connect'
  lane :release do
    build_and_upload_for_platform(
      platform_name: 'macos',
      destination: 'generic/platform=macOS',
      app_store_platform: 'osx',
      artifact: :pkg
    )
  end
end
